# Environment Configuration (TEMPLATE — never commit real values)
# Copy to .env and fill in actual values

# Database
DATABASE_URL=postgres://postgres:postgres_dev_password@localhost:5432/payment_security
DATABASE_MAX_CONNECTIONS=10

# Server
API_HOST=127.0.0.1
API_PORT=3001
RUST_LOG=info
JWT_SECRET=
JWT_ISSUER=payment-security-api

# Optional local-only first operator bootstrap. Use a unique password of at least 12 characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_TENANT_ID=22222222-2222-4222-8222-222222222222

# PayPal Sandbox (get from developer.paypal.com)
PAYPAL_CLIENT_ID=sandbox_client_id_here
PAYPAL_CLIENT_SECRET=sandbox_secret_here
PAYPAL_SANDBOX_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=webhook_id_here

# Frontend
VITE_API_URL=http://localhost:3001

# AI Provider (optional — provider-neutral)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
