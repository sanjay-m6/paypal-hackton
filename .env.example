# Environment Configuration (TEMPLATE — never commit real values)
# Copy to .env and fill in actual values

# Database
DATABASE_URL=postgres://postgres:postgres_dev_password@localhost:5432/payment_security
DATABASE_MAX_CONNECTIONS=10

# Phase 7 agent messaging. Enable only when the NATS service is available.
MESSAGING_ENABLED=false
NATS_URL=nats://127.0.0.1:4222
NATS_REQUIRE_TLS=false
NATS_USERNAME=
NATS_PASSWORD=
NATS_STREAM_NAME=PAYMENT_AGENT_EVENTS
NATS_DEAD_LETTER_STREAM_NAME=PAYMENT_AGENT_DEAD_LETTERS
NATS_MAX_PAYLOAD_BYTES=65536
NATS_MESSAGE_TTL_SECONDS=300
NATS_MAX_DELIVERIES=5
NATS_RETRY_BASE_DELAY_MS=250
NATS_RETRY_MAX_DELAY_MS=30000
NATS_HANDLER_TIMEOUT_SECONDS=60
NATS_CONNECT_TIMEOUT_SECONDS=5
# JSON array; secrets are URL-safe Base64 encoded and must be at least 32 bytes.
# Example shape: [{"key_id":"orchestrator-1","principal":"ORCHESTRATOR","secret_base64":"..."}]
MESSAGE_SIGNING_KEYS_JSON=

# Server
API_HOST=127.0.0.1
API_PORT=3001
RUST_LOG=info
JWT_SECRET=
JWT_ISSUER=payment-security-api

# Optional local-only first operator bootstrap. Use a unique password of at least 12 characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_TENANT_ID=22222222-2222-4222-8222-222222222222

# PayPal Sandbox (get from developer.paypal.com)
PAYPAL_CLIENT_ID=sandbox_client_id_here
PAYPAL_CLIENT_SECRET=sandbox_secret_here
PAYPAL_SANDBOX_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=webhook_id_here

# Frontend
VITE_API_URL=http://localhost:3001

# AI Provider (optional — provider-neutral)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
